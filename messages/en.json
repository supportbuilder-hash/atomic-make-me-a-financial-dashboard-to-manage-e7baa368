    "faq": {
      "eyebrow": "Common questions",
      "title": "Everything you need to know",
      "subtitle": "Answers to the questions people ask before they start tracking with Centsible.",
      "items": [
        {
          "question": "How do I add a new expense?",
          "answer": "Open the Transactions page and log an amount, category and date, it appears in your dashboard instantly."
        },
        {
          "question": "Can I track savings alongside spending?",
          "answer": "Yes, Savings is treated as its own category so contributions count toward your monthly goal just like any other budget line."
        },
        {
          "question": "Does Centsible support multiple budgets per category?",
          "answer": "Each category gets one monthly budget that resets automatically, giving you a clean, simple limit to watch."
        },
        {
          "question": "What happens when I go over budget?",
          "answer": "The category card switches to an over-budget state and the monthly summary flags it so you can adjust before the next cycle."
        }
      ]
    },
